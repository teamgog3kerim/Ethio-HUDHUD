# Names only. Configure values through workspace secrets/environment settings.
# Server-only:
DATABASE_URL=
SESSION_SECRET=
CLERK_SECRET_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Publishable Clerk keys (not secret keys):
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Proxy configuration is populated by managed auth when applicable:
CLERK_PROXY_URL=
VITE_CLERK_PROXY_URL=
EXPO_PUBLIC_CLERK_PROXY_URL=

# Expo API domain: hostname only, no protocol. Use the actual published domain
# for production builds; development workflows inject their development domain.
EXPO_PUBLIC_DOMAIN=
