modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/ethio-hudhud: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow]]
name = "learning-path-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test:learning-path"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ADMIN_BOOTSTRAP_EMAIL = "teamgog3@gmail.com"

[userenv.development]
POLAR_SANDBOX_APP_URL = "https://3e612faa-2e4d-4ee4-b145-759195952e72-00-2plfn9im0vkeb.reed.replit.dev"
POLAR_SANDBOX_CHECKOUT_ENABLED = "true"
POLAR_SANDBOX_MONTHLY_PRODUCT_ID = "f921b6f4-7800-40c4-b091-d5db11360c17"
POLAR_SANDBOX_SIX_MONTH_PRODUCT_ID = "134ce7d5-dfaf-49ca-91eb-19859e4c6525"
POLAR_LIVE_MONTHLY_PRODUCT_ID = "7fff523f-51ec-4d84-87b1-5ef43bc9a3ae"
POLAR_LIVE_SIX_MONTH_PRODUCT_ID = "7894c8ae-bf15-4aec-973b-635bf0521920"

[nix]
channel = "stable-25_05"
packages = ["chromium"]
