# TEMPLATE ONLY. Do not commit real values. Enter them in EthioDeploy settings.
# Set the same values at build and runtime. VITE_* values are public in the JS bundle.
NODE_ENV=production
VITE_PUBLIC_APP_URL=https://YOUR-PROJECT.ethiodeploy.com
PUBLIC_APP_URL=https://YOUR-PROJECT.ethiodeploy.com
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SESSION_SECRET=
# Provided by the Postgres addon, or your own PostgreSQL service:
DATABASE_URL=
# Platform-provided PORT is preferred; the standalone launcher defaults to 3000.
# PORT=3000
# Use the verified owner email described in docs/ETHIODEPLOY.md:
ADMIN_BOOTSTRAP_EMAIL=
# First launch on an EMPTY database only, or one already managed by these migrations.
# Turn off again after a successful initial deploy; run future migrations once per release.
RUN_DATABASE_MIGRATIONS=false

# Optional AI tutor: use your own provider credentials outside Replit.
# Standard OpenAI billing is separate from hosting and Replit AI billing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# Optional browser push renewal reminders:
RENEWAL_VAPID_PUBLIC_KEY=
RENEWAL_VAPID_PRIVATE_KEY=
RENEWAL_VAPID_SUBJECT=

# Optional Clerk proxy (only if explicitly configured for your production tenant).
# Leave both unset for standard Clerk domain/DNS configuration.
# VITE_CLERK_PROXY_URL=https://YOUR-PROJECT.ethiodeploy.com/api/__clerk
# CLERK_PROXY_URL=https://YOUR-PROJECT.ethiodeploy.com/api/__clerk
